{
  "name": "werewolfdemo-local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "本地运行的AI狼人杀MVP：React + Node.js + SQLite",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --experimental-strip-types server/index.ts --dev",
    "build": "npm run typecheck && vite build",
    "start": "node --experimental-strip-types server/index.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "node --experimental-strip-types tests/e2e.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
